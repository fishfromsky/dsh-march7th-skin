{
  "name": "dsh-march7th-skin",
  "description": "Standalone pluggable March 7th (Honkai: Star Rail) skin for the dsh web GUI: theme tokens, night background, and character art flanking the input. Not part of the default web-app — add this package to a profile bundle to enable.",
  "version": "0.3.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "skin",
    "theme",
    "march-7th",
    "honkai-star-rail"
  ],
  "homepage": "https://github.com/fishfromsky/dsh-march7th-skin#readme",
  "bugs": {
    "url": "https://github.com/fishfromsky/dsh-march7th-skin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishfromsky/dsh-march7th-skin.git"
  },
  "author": "fishfromsky",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "assets",
    "cordis.patch.yml",
    "docs",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"tests/*.test.mjs\"",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "prepack": "pnpm run check",
    "release:pack": "pnpm pack --pack-destination release",
    "publish:dry-run": "pnpm publish --dry-run --no-git-checks",
    "dev:sync": "node scripts/dev-sync.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
